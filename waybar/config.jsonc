{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,

  "modules-left": ["niri/workspaces"],
  "modules-center": [],
  "modules-right": ["tray", "network", "pulseaudio", "cpu", "memory", "clock"],

  "niri/workspaces": {
    "format": "{id}",
    "sort-by": "number",
    "all-outputs": true,
    "active-only": false,

    // Always show 1..5 even if empty:
    "persistent-workspaces": {
      "*": 5
    }
  },

  "network": {
    "interval": 5,

    // Simple speed only (no wifi/ethernet name):
    "format-wifi": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-ethernet": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",

    // Hide when disconnected:
    "format-disconnected": "",

    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": "RAM {percentage}%",
    "tooltip": false
  },

  "clock": {
    "interval": 30,
    "format": "{:%a %m-%d %H:%M}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
